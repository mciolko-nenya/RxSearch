# Optional: default ZIP code used for pharmacy pricing lookups (5 digits).
DEFAULT_ZIP_CODE=

# Run browsers headless by default (true/false). --debug overrides to false.
HEADLESS_DEFAULT=true

# Timeouts (seconds).
REQUEST_TIMEOUT_SECONDS=15
SELENIUM_PAGE_LOAD_TIMEOUT=30
SELENIUM_WAIT_TIMEOUT=15

# Path (relative to repo root, or absolute) where the persistent Amazon
# Chrome profile is stored. Created by `python main.py --setup-amazon`.
# This is NOT a credential store — do not put an Amazon username/password
# anywhere in this file. Amazon login is done interactively, once, and the
# resulting session cookies live only in this local profile directory.
AMAZON_CHROME_PROFILE_DIR=.chrome-profile-amazon

# Comma-separated list of sites to query by default (overridable per-run
# with --sites). Valid values: goodrx,singlecare,amazon,costplusdrugs
ENABLED_SITES=goodrx,singlecare,amazon,costplusdrugs

# How Cost Plus Drugs is looked up:
#   live - always scrape the live site (default).
#   file - check the static formulary spreadsheet (COSTPLUSDRUGS_FORMULARY_PATH)
#          first; if the drug/dosage/formulation isn't listed there, skip the
#          live site entirely (not carried). If it IS listed, still scrapes
#          live for the actual price — the spreadsheet has no pricing, only
#          what's carried.
COSTPLUSDRUGS_LOOKUP_MODE=live

# Path (relative to repo root, or absolute) to the Team Cuban Card
# downloadable medication list (.xlsx). Only read when
# COSTPLUSDRUGS_LOOKUP_MODE=file.
COSTPLUSDRUGS_FORMULARY_PATH=TeamCubanCard_DownloadableMedicationList_08.06.2026.xlsx
